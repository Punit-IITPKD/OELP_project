  "hypotheses": [
    {
      "hypothesis": "H1",
      "statement": "Customers whose current gap is unusually long relative to their own history are less likely to purchase soon.",
      "status": "supported_in_multiple_horizons",
      "evidence_summary": "P30 AP delta 0.003 (95% CI -0.001 to 0.007), P60 AP delta 0.008 (95% CI 0.004 to 0.012), P90 AP delta 0.007 (95% CI 0.004 to 0.010)"
    },
    {
      "hypothesis": "H2",
      "statement": "A decline in recent purchasing rate relative to earlier activity contains additional predictive information.",
      "status": "inconclusive",
      "evidence_summary": "P30 AP delta 0.001 (95% CI -0.002 to 0.003), P60 AP delta 0.007 (95% CI -0.002 to 0.014), P90 AP delta -0.000 (95% CI -0.017 to 0.015)"
    },
    {
      "hypothesis": "H3",
      "statement": "A reduction in purchasing revenue rate may indicate deterioration, although spending is noisy.",
      "status": "supported_in_multiple_horizons",
      "evidence_summary": "P30 AP delta -0.000 (95% CI -0.002 to 0.002), P60 AP delta 0.004 (95% CI 0.002 to 0.005), P90 AP delta 0.004 (95% CI 0.002 to 0.007)"
    },
    {
      "hypothesis": "H4",
      "statement": "The direction and persistence of behavior changes may add information beyond instantaneous inactivity.",
      "status": "inconclusive",
      "evidence_summary": "P30 AP delta 0.000 (95% CI -0.000 to 0.000), P60 AP delta -0.000 (95% CI -0.001 to 0.000), P90 AP delta 0.001 (95% CI -0.001 to 0.004)"
    },
    {
      "hypothesis": "H5",
      "statement": "Behavior features add independent prospective information beyond the existing Purchase Clock.",
      "status": "not_assessed_candidate_F_vintage_ineligible",
      "evidence_summary": "Candidate E and the existing Purchase Clock are compared on the locked TEST cohort (P30 AP difference -0.038 (95% CI -0.048 to -0.027), P60 AP difference -0.046 (95% CI -0.064 to -0.029), P90 AP difference -0.061 (95% CI -0.082 to -0.039)). A conditional Candidate F was not fitted because no saved Purchase Clock prediction vintage exists at the official TRAIN cutoffs; separate-model comparison cannot establish independent incremental information."
    }
  ],
  "limitations": [
    "Outcome means no observed purchase within the next H days; it is not permanent churn.",
    "The Year 1 UK retail cohort is sparse and the results are historical backtests, not live forecasts or intervention effects.",
    "Candidate F was not fitted because the saved Purchase Clock prediction vintages postdate every official TRAIN cutoff.",
    "Candidate E versus the Purchase Clock compares two separately trained/ranked methods; it does not establish independent incremental value without Candidate F.",
    "The top-10% ranking comparison is an evaluation budget, not a deployed alert policy. No categorical alert states are enabled.",
    "Customer-level bootstrap intervals assume the held-out TEST cutoff contributes one row per customer; repeated customer snapshots are not bootstrapped as independent rows.",
    "Some recent/reference revenue and EWMA features are unavailable for customers with sparse or zero-revenue histories."
  ],
